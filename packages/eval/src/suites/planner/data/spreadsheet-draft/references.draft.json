{
  "easy-23-google-sheet-row": {
    "schemaVersion": 1,
    "name": "영수증 구글 시트 기록",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Receipts",
          "glob": "*.pdf"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "google.sheets.append@1",
        "config": {
          "connection": "google-main",
          "spreadsheetId": "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms",
          "values": [
            "{{n1.output.date}}",
            "{{n1.output.amount}}"
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  },
  "easy-24-excel-file-and-table": {
    "schemaVersion": 1,
    "name": "Friday ledger check",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.cron@1",
        "config": {
          "expression": "0 17 * * 5"
        }
      },
      {
        "id": "n1",
        "type": "microsoft.excel.append@1",
        "config": {
          "connection": "microsoft-main",
          "filePath": "Receipts/ledger.xlsx",
          "table": "Expenses",
          "values": [
            "weekly check done"
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      }
    ]
  },
  "attach-08-spreadsheet-id-in-attachment": {
    "schemaVersion": 1,
    "name": "영수증 구글 시트 기록(txt)",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Receipts",
          "glob": "*.txt"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "google.sheets.append@1",
        "config": {
          "connection": "google-main",
          "spreadsheetId": "1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms",
          "values": [
            "{{n1.output.date}}",
            "{{n1.output.amount}}"
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  }
}
