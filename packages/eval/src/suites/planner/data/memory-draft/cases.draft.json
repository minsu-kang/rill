    {
      "id": "mem-01-folder-from-note",
      "category": "memory",
      "language": "ko",
      "prompt": "영수증 정리해서 슬랙으로 알려줘.",
      "context": {
        "connections": [
          "slack-ops"
        ],
        "allowedFolders": [
          "/Users/demo/Documents/Work",
          "/Users/demo/Documents/Personal",
          "/Users/demo/Downloads"
        ],
        "memory": [
          "내 영수증 PDF는 항상 ~/Documents/Work/Receipts 폴더에 들어와요."
        ]
      },
      "effort": "medium",
      "expect": {
        "outcome": "workflow",
        "assertions": [
          {
            "check": "hasTrigger",
            "type": "trigger.folderWatch@1"
          },
          {
            "check": "hasNode",
            "type": "trigger.folderWatch@1",
            "config": {
              "folder": {
                "$contains": "Documents/Work/Receipts"
              }
            }
          },
          {
            "check": "referencesOutputOf",
            "fromType": "trigger.folderWatch@1",
            "toType": "llm.extract@1",
            "field": "file"
          },
          {
            "check": "hasNode",
            "type": "notify.slack@1",
            "config": {
              "connection": "slack-ops"
            }
          },
          {
            "check": "orderedBefore",
            "typeA": "llm.extract@1",
            "typeB": "notify.slack@1"
          },
          {
            "check": "usesConnection",
            "name": "slack-ops"
          },
          {
            "check": "pathInsideAllowedFolders"
          },
          {
            "check": "noNodeOutsideCatalog"
          }
        ],
        "why": "The prompt does not name the folder and the context allows three, but the saved note names ~/Documents/Work/Receipts, so the planner uses it and builds the workflow without asking."
      }
    },
