            "fromType": "http.request@1",
            "toType": "notify.slack@1"
          },
          {
            "check": "orderedBefore",
            "typeA": "http.request@1",
            "typeB": "notify.slack@1"
          },
          {
            "check": "usesConnection",
            "name": "slack-alerts"
          },
          {
            "check": "hasNodeCount",
            "type": "notify.slack@1",
            "min": 1,
            "max": 1
          },
          {
            "check": "noNodeOutsideCatalog"
          }
