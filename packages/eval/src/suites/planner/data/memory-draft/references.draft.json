{
  "mem-01-folder-from-note": {
    "schemaVersion": 1,
    "name": "영수증 정리 알림",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Documents/Work/Receipts",
          "glob": "*.pdf"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number",
              "description": "합계 금액"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "notify.slack@1",
        "config": {
          "connection": "slack-ops",
          "text": "새 영수증 {{n1.output.date}}: {{n1.output.amount}}원"
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  },
  "mem-03-connection-from-note": {
    "schemaVersion": 1,
    "name": "서버 상태 알림",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.cron@1",
        "config": {
          "expression": "0 9 * * *"
        }
      },
      {
        "id": "n1",
        "type": "http.request@1",
        "config": {
          "url": "https://api.example.com/health",
          "method": "GET"
        }
      },
      {
        "id": "n2",
        "type": "notify.slack@1",
        "config": {
          "connection": "slack-alerts",
          "text": "서버 상태 코드: {{n1.output.status}}"
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  },
  "mem-04-request-beats-note": {
    "schemaVersion": 1,
    "name": "다운로드 영수증 장부",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Downloads",
          "glob": "*.pdf"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "csv.append@1",
        "config": {
          "file": "/Users/demo/Downloads/ledger.csv",
          "row": [
            "{{n1.output.date}}",
            "{{n1.output.amount}}"
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  },
  "mem-05-irrelevant-note": {
    "schemaVersion": 1,
    "name": "월간 보고 알림",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.cron@1",
        "config": {
          "expression": "0 9 1 * *"
        }
      },
      {
        "id": "n1",
        "type": "notify.slack@1",
        "config": {
          "connection": "slack-ops",
          "text": "월간 보고서 제출하세요"
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      }
    ]
  },
  "mem-06-note-url-beats-attachment-url": {
    "schemaVersion": 1,
    "name": "주문 내역 경비 서버 전송",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Receipts",
          "glob": "*.txt"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number",
              "description": "총 결제금액"
            },
            {
              "name": "orderDate",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "http.request@1",
        "config": {
          "url": "https://billing.example.com/api/expenses",
          "method": "POST",
          "body": {
            "orderDate": "{{n1.output.orderDate}}",
            "amount": "{{n1.output.amount}}"
          }
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  },
  "mem-07-one-of-twenty-notes": {
    "schemaVersion": 1,
    "name": "업무 영수증 장부",
    "nodes": [
      {
        "id": "t1",
        "type": "trigger.folderWatch@1",
        "config": {
          "folder": "/Users/demo/Documents/Work/Receipts",
          "glob": "*.pdf"
        }
      },
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [
            {
              "name": "amount",
              "type": "number"
            },
            {
              "name": "date",
              "type": "date"
            }
          ]
        }
      },
      {
        "id": "n2",
        "type": "csv.append@1",
        "config": {
          "file": "/Users/demo/Documents/Work/ledger.csv",
          "row": [
            "{{n1.output.date}}",
            "{{n1.output.amount}}"
          ]
        }
      }
    ],
    "edges": [
      {
        "from": "t1",
        "to": "n1"
      },
      {
        "from": "n1",
        "to": "n2"
      }
    ]
  }
}
