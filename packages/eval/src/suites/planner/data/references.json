  "easy-20-receipt-fields-to-http": {
    "schemaVersion": 1,
    "name": "영수증 청구 서버 전송",
    "nodes": [
      {"id": "t1", "type": "trigger.folderWatch@1", "config": {"folder": "/Users/demo/Receipts", "glob": "*.pdf"}},
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {
          "file": "{{t1.output.file}}",
          "fields": [{"name": "vendor", "type": "string", "description": "가게 이름"}, {"name": "date", "type": "date"}, {"name": "amount", "type": "number"}]
        }
      },
      {
        "id": "n2",
        "type": "http.request@1",
        "config": {
          "url": "https://billing.example.com/api/expenses",
          "method": "POST",
          "body": {"vendor": "{{n1.output.vendor}}", "date": "{{n1.output.date}}", "amount": "{{n1.output.amount}}"},
          "auth": {"connection": "billing-api"}
        },
        "retry": {"maxAttempts": 3}
      }
    ],
    "edges": [{"from": "t1", "to": "n1"}, {"from": "n1", "to": "n2"}]
  },
