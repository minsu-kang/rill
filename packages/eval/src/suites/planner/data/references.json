{
  "easy-01-receipt-folder-to-csv": {
    "schemaVersion": 1,
    "name": "영수증 정리",
    "nodes": [
      {"id": "t1", "type": "trigger.folderWatch@1", "config": {"folder": "/Users/demo/Receipts", "glob": "*.pdf"}},
      {
        "id": "n1",
        "type": "llm.extract@1",
        "config": {"file": "{{t1.output.file}}", "fields": [{"name": "amount", "type": "number", "description": "합계 금액"}, {"name": "date", "type": "date", "description": "결제 날짜"}]}
      },
      {"id": "n2", "type": "csv.append@1", "config": {"file": "/Users/demo/Receipts/ledger.csv", "row": ["{{n1.output.date}}", "{{n1.output.amount}}"]}}
    ],
    "edges": [{"from": "t1", "to": "n1"}, {"from": "n1", "to": "n2"}]
  },
  "easy-02-weekday-morning-health-check": {
    "schemaVersion": 1,
    "name": "서버 상태 확인",
    "nodes": [
      {"id": "t1", "type": "trigger.cron@1", "config": {"expression": "0 9 * * 1-5"}},
      {"id": "n1", "type": "http.request@1", "config": {"url": "https://api.example.com/health", "method": "GET"}}
    ],
    "edges": [{"from": "t1", "to": "n1"}]
  },
  "easy-03-webhook-to-slack": {
    "schemaVersion": 1,
    "name": "새 주문 알림",
    "nodes": [
      {"id": "t1", "type": "trigger.webhook@1", "config": {"path": "/orders", "method": "POST"}},
      {"id": "n1", "type": "notify.slack@1", "config": {"connection": "slack-ops", "text": "새 주문이 들어왔어요"}}
    ],
    "edges": [{"from": "t1", "to": "n1"}]
  },
  "easy-04-large-receipt-branch": {
    "schemaVersion": 1,
    "name": "큰 영수증 분기",
    "nodes": [
      {"id": "t1", "type": "trigger.folderWatch@1", "config": {"folder": "/Users/demo/Receipts", "glob": "*.pdf"}},
      {"id": "n1", "type": "llm.extract@1", "config": {"file": "{{t1.output.file}}", "fields": [{"name": "amount", "type": "number"}, {"name": "date", "type": "date"}]}},
      {"id": "n2", "type": "condition@1", "config": {"left": "{{n1.output.amount}}", "operator": "gt", "right": 100000}},
      {"id": "n3", "type": "notify.slack@1", "config": {"connection": "slack-ops", "text": "10만원이 넘는 영수증: {{n1.output.amount}}원"}},
      {"id": "n4", "type": "csv.append@1", "config": {"file": "/Users/demo/Receipts/ledger.csv", "row": ["{{n1.output.date}}", "{{n1.output.amount}}"]}}
    ],
    "edges": [{"from": "t1", "to": "n1"}, {"from": "n1", "to": "n2"}, {"from": "n2", "to": "n3", "when": "true"}, {"from": "n2", "to": "n4", "when": "false"}]
  },
  "easy-05-delay-then-slack": {
    "schemaVersion": 1,
    "name": "인보이스 알림",
