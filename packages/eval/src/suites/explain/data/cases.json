    {
      "id": "explain-04-file-deleted",
      "title": "a file.read of a path that was deleted",
      "workflow": {
        "schemaVersion": 1,
        "name": "Explain 04: read the notes file",
        "nodes": [
          {
            "id": "t1",
            "type": "trigger.manual@1",
            "config": {}
          },
          {
            "id": "n1",
            "type": "file.read@1",
            "config": {
              "path": "/Users/demo/Receipts/notes-2026-11.txt"
            }
          },
          {
            "id": "n2",
            "type": "csv.append@1",
            "config": {
              "file": "/Users/demo/Receipts/ledger.csv",
              "row": [
                "{{n1.output.text}}"
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "t1",
            "to": "n1"
          },
