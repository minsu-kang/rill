              "url": "https://api.example.com/limits",
              "method": "GET"
            }
          },
          {
            "id": "n1",
            "type": "http.request@1",
            "config": {
              "url": "https://api.example.com/orders",
              "method": "POST",
              "body": {
                "customer": "ACME",
                "amount": 120
              }
            },
            "retry": {
              "maxAttempts": 3,
