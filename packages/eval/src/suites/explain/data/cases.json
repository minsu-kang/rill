    {
      "id": "explain-05-extract-empty-input",
      "title": "an llm.extract whose input file was empty",
      "workflow": {
        "schemaVersion": 1,
        "name": "Explain 05: extract from new receipts",
        "nodes": [
          {
            "id": "t1",
            "type": "trigger.folderWatch@1",
            "config": {
              "folder": "/Users/demo/Receipts",
              "glob": "*.txt"
            }
          },
          {
            "id": "n1",
            "type": "llm.extract@1",
            "config": {
              "file": "{{t1.output.file}}",
              "fields": [
                {
                  "name": "amount",
                  "type": "number"
                },
                {
                  "name": "date",
                  "type": "date"
                }
              ]
            }
          },
          {
            "id": "n2",
            "type": "csv.append@1",
            "config": {
              "file": "/Users/demo/Receipts/ledger.csv",
              "row": [
                "{{n1.output.date}}",
                "{{n1.output.amount}}"
              ]
            }
          }
        ],
        "edges": [
          {
            "from": "t1",
            "to": "n1"
          },
          {
            "from": "n1",
            "to": "n2"
          }
        ]
      },
      "run": {
        "status": "failed",
        "dryRun": false,
        "error": "node n1 failed: file is empty: /Users/demo/Receipts/empty-receipt.txt",
        "createdAt": 1794470000000,
        "startedAt": 1794470000040,
        "finishedAt": 1794470000100
      },
      "steps": [
        {
          "nodeId": "n1",
          "attempt": 1,
          "status": "failed",
          "input": {
            "file": "/Users/demo/Receipts/empty-receipt.txt",
            "fields": [
              {
                "name": "amount",
                "type": "number"
              },
              {
                "name": "date",
                "type": "date"
              }
            ]
          },
          "output": null,
          "error": "file is empty: /Users/demo/Receipts/empty-receipt.txt",
          "startedAt": 1794470000040,
          "finishedAt": 1794470000060
        }
      ],
      "secrets": [],
      "effort": "low",
      "expect": {
        "signals": [
          {
            "nodeId": "n1",
            "signal": "file_unreadable"
          }
        ],
        "likelyCause": [
          "input_data"
        ],
        "actions": [
          "check_input_file"
        ],
        "mention": [
          "n1",
          "Extract fields with AI"
        ]
      }
    },
