            "config": {}
          },
          {
            "id": "n1",
            "type": "http.request@1",
            "config": {
              "url": "https://api.example.com/invoices",
              "method": "POST",
              "body": {
                "customer": "ACME",
                "amount": 120
              },
              "auth": {
                "connection": "billing-api"
