            "from": "n1",
            "to": "n2"
          }
        ]
      },
      "run": {
        "status": "failed",
        "dryRun": false,
        "error": "node n1 failed: ENOENT: no such file or directory, stat '/Users/demo/Receipts/notes-2026-11.txt'",
        "createdAt": 1794470000000,
        "startedAt": 1794470000040,
        "finishedAt": 1794470000100
      },
      "steps": [
        {
          "nodeId": "n1",
          "attempt": 1,
