{
  "name": "@rill/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "fixtures": "node --import tsx scripts/make-catalog-fixture.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.main.json",
    "bundle-engine": "node --import tsx scripts/bundle-engine.ts",
    "build": "pnpm bundle-engine && electron-vite build",
    "dev": "pnpm bundle-engine && electron-vite dev",
    "smoke": "electron . --smoke",
    "dist": "pnpm build && electron-builder --config electron-builder.yml --mac --publish never"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@rill/dsl": "workspace:*",
    "@rill/protocol": "workspace:*",
    "@xyflow/react": "12.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@rill/engine": "workspace:*",
    "@rill/llm": "workspace:*",
    "@rill/nodes-core": "workspace:*",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.0",
    "storybook": "10.6.7",
    "typebox": "^1.4.6",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  },
  "main": "dist/main/index.mjs",
  "description": "Rill desktop app",
  "author": "Rill"
}
