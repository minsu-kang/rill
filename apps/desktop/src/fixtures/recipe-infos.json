{
  "recipes": [
    {
      "id": "receipt-folder-to-csv",
      "title": {
        "ko": "영수증 폴더를 CSV로 정리",
        "en": "Receipt folder to CSV"
      },
      "description": {
        "ko": "폴더에 영수증이 들어오면 AI가 금액, 날짜, 가게 이름을 읽어 CSV 파일에 한 줄씩 쌓아요.",
        "en": "When a receipt lands in a folder, AI reads the amount, date and vendor and appends one row to a CSV file."
      },
      "tags": [
        "receipts",
        "csv",
        "ai",
        "folder"
      ],
      "params": [
        {
          "id": "watchFolder",
          "kind": "folder",
          "label": {
            "ko": "감시할 폴더",
            "en": "Folder to watch"
          },
          "help": {
            "ko": "새 영수증 파일이 들어오는 폴더예요.",
            "en": "The folder where new receipt files arrive."
          },
          "required": true
        },
        {
          "id": "glob",
          "kind": "glob",
          "label": {
            "ko": "파일 이름 패턴",
            "en": "File name pattern"
          },
          "help": {
            "ko": "처리할 파일의 이름 패턴이에요. 기본값은 PDF 파일이에요.",
            "en": "Which files to process. The default matches PDF files."
          },
          "required": false,
          "default": "*.pdf"
        },
        {
          "id": "csvFile",
          "kind": "file",
          "label": {
            "ko": "CSV 파일",
            "en": "CSV file"
          },
          "help": {
            "ko": "영수증 한 장을 한 줄씩 쌓을 CSV 파일의 경로예요. .csv로 끝나야 하고, 감시할 폴더 밖에 두세요.",
            "en": "The CSV file that receives one row per receipt. It must end in .csv and sit outside the watched folder, or each new row would start the workflow again."
          },
          "required": true,
          "extension": ".csv"
        }
      ],
      "nodeTypes": [
        "trigger.folderWatch@1",
        "llm.extract@1",
        "csv.append@1"
      ],
      "needsConnection": false
    },
    {
      "id": "receipt-big-amount-alert",
      "title": {
        "ko": "큰 금액 영수증 알림",
        "en": "Big receipt alert"
      },
      "description": {
        "ko": "영수증을 CSV에 쌓으면서, 기준 금액보다 큰 영수증은 슬랙으로 알려요.",
        "en": "Records receipts in a CSV file like the receipt ledger and sends a Slack message for a receipt above a threshold."
      },
      "tags": [
        "receipts",
        "csv",
        "ai",
        "folder",
        "slack"
      ],
      "params": [
        {
          "id": "watchFolder",
          "kind": "folder",
          "label": {
            "ko": "감시할 폴더",
            "en": "Folder to watch"
          },
          "help": {
            "ko": "새 영수증 파일이 들어오는 폴더예요.",
            "en": "The folder where new receipt files arrive."
          },
          "required": true
        },
        {
          "id": "glob",
          "kind": "glob",
          "label": {
            "ko": "파일 이름 패턴",
            "en": "File name pattern"
          },
          "help": {
            "ko": "처리할 파일의 이름 패턴이에요. 기본값은 PDF 파일이에요.",
            "en": "Which files to process. The default matches PDF files."
          },
          "required": false,
          "default": "*.pdf"
        },
        {
          "id": "csvFile",
          "kind": "file",
          "label": {
            "ko": "CSV 파일",
            "en": "CSV file"
          },
          "help": {
            "ko": "영수증 한 장을 한 줄씩 쌓을 CSV 파일의 경로예요. .csv로 끝나야 하고, 감시할 폴더 밖에 두세요.",
            "en": "The CSV file that receives one row per receipt. It must end in .csv and sit outside the watched folder, or each new row would start the workflow again."
          },
          "required": true,
          "extension": ".csv"
        },
        {
          "id": "threshold",
          "kind": "number",
          "label": {
            "ko": "기준 금액",
            "en": "Threshold amount"
          },
          "help": {
            "ko": "이 금액보다 큰 영수증이면 슬랙으로 알려요.",
            "en": "A receipt above this amount triggers a Slack message."
          },
          "required": true,
          "min": 0,
          "max": 1000000000000
        },
        {
          "id": "slackConnection",
          "kind": "connection",
          "label": {
            "ko": "슬랙 연결",
            "en": "Slack connection"
          },
          "help": {
            "ko": "알림을 받을 슬랙 연결의 이름이에요.",
            "en": "The name of the Slack connection that receives the message."
          },
          "required": true,
          "connectionKind": "slack"
        }
      ],
      "nodeTypes": [
        "trigger.folderWatch@1",
        "llm.extract@1",
        "csv.append@1",
        "condition@1",
        "notify.slack@1"
      ],
      "needsConnection": true
    },
    {
      "id": "daily-health-check",
      "title": {
        "ko": "매일 서버 상태 확인",
        "en": "Daily health check"
      },
      "description": {
        "ko": "정해진 시각에 주소를 호출해서 응답이 없거나 성공(2xx) 응답이 아니면 슬랙으로 알려요.",
        "en": "Calls a URL on a schedule and sends a Slack message when it does not answer or the answer is not a success (2xx)."
      },
      "tags": [
        "monitoring",
        "schedule",
        "http",
        "slack"
      ],
      "params": [
        {
          "id": "schedule",
          "kind": "cron",
          "label": {
            "ko": "실행 시각",
            "en": "Schedule"
          },
          "help": {
            "ko": "5칸 cron 식이에요. 기본값은 평일 오전 9시예요.",
            "en": "A five-field cron expression. The default is weekdays at 9:00."
          },
          "required": false,
          "default": "0 9 * * 1-5"
        },
        {
          "id": "url",
          "kind": "url",
          "label": {
            "ko": "확인할 주소",
            "en": "URL to check"
          },
          "help": {
            "ko": "http 또는 https로 시작하는 주소예요. 비밀번호나 토큰은 넣지 마세요.",
            "en": "An address that starts with http or https. Do not put a password or token in it."
          },
          "required": true
        },
        {
          "id": "slackConnection",
          "kind": "connection",
          "label": {
            "ko": "슬랙 연결",
            "en": "Slack connection"
          },
          "help": {
            "ko": "알림을 받을 슬랙 연결의 이름이에요.",
            "en": "The name of the Slack connection that receives the message."
          },
          "required": true,
          "connectionKind": "slack"
        }
      ],
      "nodeTypes": [
        "trigger.cron@1",
        "http.request@1",
        "condition@1",
        "notify.slack@1"
      ],
      "needsConnection": true
    },
    {
      "id": "webhook-to-slack",
      "title": {
        "ko": "웹훅을 슬랙으로 전달",
        "en": "Webhook to Slack"
      },
      "description": {
        "ko": "이 컴퓨터의 웹훅 주소로 요청이 들어오면 슬랙에 정해진 메시지를 보내요.",
        "en": "Sends a fixed Slack message whenever a request reaches a webhook path on this computer."
      },
      "tags": [
        "webhook",
        "slack"
      ],
      "params": [
        {
          "id": "slackConnection",
          "kind": "connection",
          "label": {
            "ko": "슬랙 연결",
            "en": "Slack connection"
          },
          "help": {
            "ko": "알림을 받을 슬랙 연결의 이름이에요.",
            "en": "The name of the Slack connection that receives the message."
          },
          "required": true,
          "connectionKind": "slack"
        }
      ],
      "nodeTypes": [
        "trigger.webhook@1",
        "notify.slack@1"
      ],
      "needsConnection": true
    },
    {
      "id": "monthly-reminder",
      "title": {
        "ko": "매월 알림",
        "en": "Monthly reminder"
      },
      "description": {
        "ko": "정해진 시각에 슬랙으로 알림 메시지를 보내요. 기본값은 매월 1일 오전 9시예요.",
        "en": "Sends a Slack reminder on a schedule. The default is the first day of each month at 9:00."
      },
      "tags": [
        "schedule",
        "slack",
        "reminder"
      ],
      "params": [
        {
          "id": "schedule",
          "kind": "cron",
          "label": {
            "ko": "실행 시각",
            "en": "Schedule"
          },
          "help": {
            "ko": "5칸 cron 식이에요. 기본값은 매월 1일 오전 9시예요.",
            "en": "A five-field cron expression. The default is the first day of each month at 9:00."
          },
          "required": false,
          "default": "0 9 1 * *"
        },
        {
          "id": "message",
          "kind": "text",
          "label": {
            "ko": "알림 메시지",
            "en": "Message"
          },
          "help": {
            "ko": "슬랙으로 보낼 한 줄 메시지예요.",
            "en": "A one-line message to send to Slack."
          },
          "required": false,
          "default": "이번 달 정산을 확인할 시간이에요."
        },
        {
          "id": "slackConnection",
          "kind": "connection",
          "label": {
            "ko": "슬랙 연결",
            "en": "Slack connection"
          },
          "help": {
            "ko": "알림을 받을 슬랙 연결의 이름이에요.",
            "en": "The name of the Slack connection that receives the message."
          },
          "required": true,
          "connectionKind": "slack"
        }
      ],
      "nodeTypes": [
        "trigger.cron@1",
        "notify.slack@1"
      ],
      "needsConnection": true
    },
    {
      "id": "failure-webhook-alert",
      "title": {
        "ko": "실패 알림 전달",
        "en": "Failure webhook alert"
      },
      "description": {
        "ko": "웹훅 요청 본문의 status가 실패 값이면 슬랙으로 알려요.",
        "en": "Sends a Slack message when the status in a webhook request body is the failure value."
      },
      "tags": [
        "webhook",
        "slack",
        "monitoring"
      ],
      "params": [
        {
          "id": "slackConnection",
          "kind": "connection",
          "label": {
            "ko": "슬랙 연결",
            "en": "Slack connection"
          },
          "help": {
            "ko": "알림을 받을 슬랙 연결의 이름이에요.",
            "en": "The name of the Slack connection that receives the message."
          },
          "required": true,
          "connectionKind": "slack"
        },
        {
          "id": "failedStatus",
          "kind": "text",
          "label": {
            "ko": "실패로 볼 상태값",
            "en": "Failure status"
          },
          "help": {
            "ko": "요청 본문의 status 값이 이 값이면 알려요. status는 숫자가 아니라 문자로 보내야 해요. 예: \"500\"",
            "en": "Alert when the status field of the request body has this value. The sender must send status as text, for example \"500\", not as a number."
          },
          "required": false,
          "default": "failed"
        }
      ],
      "nodeTypes": [
        "trigger.webhook@1",
        "condition@1",
        "notify.slack@1"
      ],
      "needsConnection": true
    },
    {
      "id": "receipt-folder-to-google-sheet",
      "title": {
        "ko": "영수증 폴더를 구글 시트로 정리",
        "en": "Receipt folder to Google Sheet"
      },
      "description": {
        "ko": "폴더에 영수증이 들어오면 AI가 금액, 날짜, 가게 이름을 읽어 내 구글 계정의 스프레드시트에 한 줄씩 쌓아요.",
        "en": "When a receipt lands in a folder, AI reads the amount, date and vendor and appends one row to a Google Sheets spreadsheet in your Google account."
      },
      "tags": [
        "receipts",
        "spreadsheet",
        "google",
        "ai",
        "folder"
      ],
      "params": [
        {
          "id": "watchFolder",
          "kind": "folder",
          "label": {
            "ko": "감시할 폴더",
            "en": "Folder to watch"
          },
          "help": {
            "ko": "새 영수증 파일이 들어오는 폴더예요.",
            "en": "The folder where new receipt files arrive."
          },
          "required": true
        },
        {
          "id": "glob",
          "kind": "glob",
          "label": {
            "ko": "파일 이름 패턴",
            "en": "File name pattern"
          },
          "help": {
            "ko": "처리할 파일의 이름 패턴이에요. 기본값은 PDF 파일이에요.",
            "en": "Which files to process. The default matches PDF files."
          },
          "required": false,
          "default": "*.pdf"
        },
        {
          "id": "googleConnection",
          "kind": "connection",
          "label": {
            "ko": "구글 계정",
            "en": "Google account"
          },
          "help": {
            "ko": "설정의 연결 화면에서 연결한 구글 계정이에요.",
            "en": "The Google account that you connected in Settings, Connections."
          },
          "required": true,
          "connectionKind": "google"
        },
        {
          "id": "spreadsheetId",
          "kind": "spreadsheetId",
          "label": {
            "ko": "스프레드시트 ID",
            "en": "Spreadsheet id"
          },
          "help": {
            "ko": "스프레드시트 주소에서 /d/ 와 /edit 사이에 있는 긴 문자열이에요. 스프레드시트 제목이 아니에요.",
            "en": "The long id in the spreadsheet address, between /d/ and /edit. It is not the title of the spreadsheet."
          },
          "required": true
        }
      ],
      "nodeTypes": [
        "trigger.folderWatch@1",
        "llm.extract@1",
        "google.sheets.append@1"
      ],
      "needsConnection": true
    },
    {
      "id": "receipt-folder-to-excel",
      "title": {
        "ko": "영수증 폴더를 엑셀로 정리",
        "en": "Receipt folder to Excel"
      },
      "description": {
        "ko": "폴더에 영수증이 들어오면 AI가 금액, 날짜, 가게 이름을 읽어 내 원드라이브의 엑셀 통합 문서 표에 한 줄씩 쌓아요.",
        "en": "When a receipt lands in a folder, AI reads the amount, date and vendor and appends one row to a table in an Excel workbook in your OneDrive."
      },
      "tags": [
        "receipts",
        "spreadsheet",
        "excel",
        "ai",
        "folder"
      ],
      "params": [
        {
          "id": "watchFolder",
          "kind": "folder",
          "label": {
            "ko": "감시할 폴더",
            "en": "Folder to watch"
          },
          "help": {
            "ko": "새 영수증 파일이 들어오는 폴더예요.",
            "en": "The folder where new receipt files arrive."
          },
          "required": true
        },
        {
          "id": "glob",
          "kind": "glob",
          "label": {
            "ko": "파일 이름 패턴",
            "en": "File name pattern"
          },
          "help": {
            "ko": "처리할 파일의 이름 패턴이에요. 기본값은 PDF 파일이에요.",
            "en": "Which files to process. The default matches PDF files."
          },
          "required": false,
          "default": "*.pdf"
        },
        {
          "id": "microsoftConnection",
          "kind": "connection",
          "label": {
            "ko": "마이크로소프트 계정",
            "en": "Microsoft account"
          },
          "help": {
            "ko": "설정의 연결 화면에서 연결한 마이크로소프트 계정이에요.",
            "en": "The Microsoft account that you connected in Settings, Connections."
          },
          "required": true,
          "connectionKind": "microsoft"
        },
        {
          "id": "workbookPath",
          "kind": "driveFile",
          "label": {
            "ko": "엑셀 파일 경로",
            "en": "Workbook path"
          },
          "help": {
            "ko": "원드라이브 안에 있는 .xlsx 파일의 경로예요. 맨 앞에 /를 붙이지 않아요. 예: Receipts/ledger.xlsx",
            "en": "The path of the .xlsx workbook in your OneDrive, without a leading slash. For example Receipts/ledger.xlsx"
          },
          "required": true
        },
        {
          "id": "tableName",
          "kind": "tableName",
          "label": {
            "ko": "표 이름",
            "en": "Table name"
          },
          "help": {
            "ko": "그 파일 안에 이미 만들어 둔 엑셀 표의 이름이에요. 표가 없으면 먼저 만들어 주세요.",
            "en": "The name of a table that already exists in that workbook. Create the table first if there is none."
          },
          "required": true
        }
      ],
      "nodeTypes": [
        "trigger.folderWatch@1",
        "llm.extract@1",
        "microsoft.excel.append@1"
      ],
      "needsConnection": true
    }
  ],
  "drafts": {
    "receipt-folder-to-csv": {
      "values": {
        "watchFolder": "/Users/demo/Receipts",
        "glob": "*.png",
        "csvFile": "/Users/demo/ledger.csv"
      },
      "draft": {
        "recipeId": "receipt-folder-to-csv",
        "workflow": {
          "schemaVersion": 1,
          "name": "영수증 폴더를 CSV로 정리",
          "nodes": [
            {
              "id": "t1",
              "type": "trigger.folderWatch@1",
              "config": {
                "folder": "/Users/demo/Receipts",
                "glob": "*.png"
              }
            },
            {
              "id": "n1",
              "type": "llm.extract@1",
              "config": {
                "file": "{{t1.output.file}}",
                "fields": [
                  {
                    "name": "amount",
                    "type": "number",
                    "description": "Total amount paid"
                  },
                  {
                    "name": "date",
                    "type": "date",
                    "description": "Payment date"
                  },
                  {
                    "name": "vendor",
                    "type": "string",
                    "description": "Store or vendor name"
                  }
                ]
              },
              "retry": {
                "maxAttempts": 3
              }
            },
            {
              "id": "n2",
              "type": "csv.append@1",
              "config": {
                "file": "/Users/demo/ledger.csv",
                "row": [
                  "{{n1.output.date}}",
                  "{{n1.output.vendor}}",
                  "{{n1.output.amount}}"
                ]
              }
            }
          ],
          "edges": [
            {
              "from": "t1",
              "to": "n1"
            },
            {
              "from": "n1",
              "to": "n2"
            }
          ]
        },
        "summary": {
          "nodes": [
            {
              "id": "t1",
              "type": "trigger.folderWatch@1",
              "title": "Folder watch"
            },
            {
              "id": "n1",
              "type": "llm.extract@1",
              "title": "Extract fields with AI"
            },
            {
              "id": "n2",
              "type": "csv.append@1",
              "title": "Append CSV row"
            }
          ],
          "sideEffects": [
            "idempotent"
          ],
          "sendsToModel": true
        }
      }
    },
