[
  {
    "type": "trigger.manual@1",
    "kind": "trigger",
    "title": "Manual trigger",
    "description": "Starts the workflow when a run is requested by hand. Its output is the payload.",
    "configSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  },
  {
    "type": "trigger.cron@1",
    "kind": "trigger",
    "title": "Schedule",
    "description": "Starts the workflow on a five-field cron schedule. A schedule missed for more than a minute is skipped, or run once with catchUp \"once\"; with overlap \"skip\" a tick is dropped while the previous run is still active.",
    "configSchema": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "const": "local"
            },
            {
              "type": "string",
              "const": "utc"
            }
          ]
        },
        "catchUp": {
          "anyOf": [
            {
              "type": "string",
              "const": "skip"
            },
            {
              "type": "string",
              "const": "once"
            }
          ]
        },
        "overlap": {
          "anyOf": [
            {
              "type": "string",
              "const": "skip"
            },
            {
              "type": "string",
              "const": "queue"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "scheduledFor",
        "firedAt"
      ],
      "properties": {
        "scheduledFor": {
          "type": "string"
        },
        "firedAt": {
          "type": "string"
        }
      }
    }
  },
  {
    "type": "trigger.folderWatch@1",
    "kind": "trigger",
    "title": "Folder watch",
    "description": "Starts the workflow for each new file in a folder once the file has stopped changing. Polls the folder; files already present when the workflow is first activated are skipped unless includeExisting is true.",
    "configSchema": {
      "type": "object",
      "required": [
        "folder"
      ],
      "properties": {
        "folder": {
          "type": "string",
          "minLength": 1
        },
        "glob": {
          "type": "string",
          "minLength": 1
        },
        "pollMs": {
          "type": "integer",
          "minimum": 200,
          "maximum": 60000
        },
        "stableMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "includeExisting": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "file",
        "name",
        "extension",
        "bytes",
        "modifiedAt"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "extension": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "modifiedAt": {
          "type": "string"
        }
      }
    }
  },
  {
    "type": "trigger.webhook@1",
    "kind": "trigger",
    "title": "Webhook",
    "description": "Starts the workflow when a request reaches a path on the local webhook server (127.0.0.1 only). With secretConnection the request must send the secret in the x-rill-secret header.",
    "configSchema": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/-]{1,128}$"
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "const": "POST"
            },
            {
              "type": "string",
              "const": "PUT"
            },
            {
              "type": "string",
              "const": "GET"
            }
          ]
        },
        "secretConnection": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "method",
        "path",
        "query",
        "headers",
        "body"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "query": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          }
        },
        "headers": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          }
        },
        "body": {}
      }
    }
  },
  {
    "type": "transform@1",
    "kind": "action",
    "title": "Transform",
    "description": "Builds a new object from literal values and references to earlier node outputs.",
    "sideEffect": "none",
    "configSchema": {
      "type": "object",
      "required": [
        "values"
      ],
      "properties": {
        "values": {
          "type": "object",
          "patternProperties": {
            "^.*$": {}
          }
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {}
      }
    }
  },
  {
    "type": "csv.append@1",
    "kind": "action",
    "title": "Append CSV row",
    "description": "Appends one row to a CSV file, exactly once even if the run is retried or resumed. A text cell that starts with =, +, -, @, a tab or a carriage return gets a leading single quote so a spreadsheet shows it as text; plain numbers stay as they are.",
    "sideEffect": "idempotent",
    "configSchema": {
      "type": "object",
      "required": [
        "file",
        "row"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "file",
        "written"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "written": {
          "type": "boolean"
        }
      }
    }
  },
  {
    "type": "condition@1",
    "kind": "action",
    "title": "Condition",
    "description": "Compares two values and selects the true or false branch for edges labelled with when.",
    "sideEffect": "none",
    "configSchema": {
      "type": "object",
      "required": [
        "operator"
      ],
      "properties": {
        "left": {},
        "operator": {
          "anyOf": [
            {
              "type": "string",
              "const": "eq"
            },
            {
              "type": "string",
              "const": "neq"
            },
            {
              "type": "string",
              "const": "gt"
            },
            {
              "type": "string",
              "const": "gte"
            },
            {
              "type": "string",
              "const": "lt"
            },
            {
              "type": "string",
              "const": "lte"
            },
            {
              "type": "string",
              "const": "contains"
            },
            {
              "type": "string",
              "const": "exists"
            }
          ]
        },
        "right": {}
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "result",
        "branch"
      ],
      "properties": {
        "result": {
          "type": "boolean"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string",
              "const": "true"
            },
            {
              "type": "string",
              "const": "false"
            }
          ]
        }
      }
    }
  },
  {
    "type": "delay@1",
    "kind": "action",
    "title": "Delay",
    "description": "Waits before continuing. A run resumed after a crash waits again from the start of this node.",
    "sideEffect": "none",
    "configSchema": {
      "type": "object",
      "required": [
        "ms"
      ],
      "properties": {
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "waitedMs"
      ],
      "properties": {
        "waitedMs": {
          "type": "integer"
        }
      }
    }
  },
  {
    "type": "file.read@1",
    "kind": "action",
    "title": "Read file",
    "description": "Reads a file. Text files return their text; other files return metadata so a later node can use the path.",
    "sideEffect": "none",
    "configSchema": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "path",
        "name",
        "extension",
        "bytes",
        "kind",
        "mime"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "extension": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "const": "text"
            },
            {
              "type": "string",
              "const": "binary"
            }
          ]
        },
        "mime": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  {
    "type": "llm.extract@1",
    "kind": "action",
    "title": "Extract fields with AI",
    "description": "Reads a PDF, an image, a text file or inline text and extracts the fields you declare with a language model. The content is sent to the model provider, and a dry run also calls the model. A field the document does not state comes back as null. The model returns only the declared fields and does not choose which steps run, but the values come from the document: treat them as untrusted input when they feed file paths, URLs or conditions.",
    "sideEffect": "none",
    "configSchema": {
      "type": "object",
      "required": [
        "fields"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9_]{0,31}$"
              },
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "string"
                  },
                  {
                    "type": "string",
                    "const": "number"
                  },
                  {
                    "type": "string",
                    "const": "integer"
                  },
                  {
                    "type": "string",
                    "const": "boolean"
                  },
                  {
                    "type": "string",
                    "const": "date"
                  }
                ]
              },
              "description": {
                "type": "string",
                "maxLength": 200
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  {
    "type": "http.request@1",
    "kind": "action",
    "title": "HTTP request",
    "description": "Calls an HTTP endpoint with JSON. Network errors, timeouts, 429 and 5xx are retried; redirects and other non-2xx responses fail the node. Non-GET calls send an Idempotency-Key header. Credentials come from a connection, never from the workflow.",
    "sideEffect": "external",
    "configSchema": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "method": {
          "anyOf": [
            {
              "type": "string",
              "const": "GET"
            },
            {
              "type": "string",
              "const": "POST"
            },
            {
              "type": "string",
              "const": "PUT"
            },
            {
              "type": "string",
              "const": "PATCH"
            },
            {
              "type": "string",
              "const": "DELETE"
            }
          ]
        },
        "headers": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          }
        },
        "body": {},
        "auth": {
          "type": "object",
          "required": [
            "connection"
          ],
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1
            },
            "header": {
              "type": "string",
              "minLength": 1
            },
            "scheme": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "Bearer"
                },
                {
                  "type": "string",
                  "const": "Basic"
                },
                {
                  "type": "string",
                  "const": "None"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "status",
        "headers",
        "body"
      ],
      "properties": {
        "status": {
          "type": "integer"
        },
        "headers": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string"
            }
          }
        },
        "body": {},
        "dryRun": {
          "type": "boolean"
        }
      }
    }
  },
  {
    "type": "notify.slack@1",
    "kind": "action",
    "title": "Slack message",
    "description": "Posts a message through a Slack webhook connection or a bot token connection. A crash right after sending can make a resumed run send it twice. The channel is read by a bot token connection only: leave it out unless the user named a channel, otherwise the default channel of the connection is used.",
    "sideEffect": "external",
    "configSchema": {
      "type": "object",
      "required": [
        "connection",
        "text"
      ],
      "properties": {
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "sent",
        "status"
      ],
      "properties": {
        "sent": {
          "type": "boolean"
        },
        "status": {
          "type": "integer"
        }
      }
    }
  }
]
